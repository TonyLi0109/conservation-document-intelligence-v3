.env
.env.*
!.env.example

# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Generated databases and evaluation output
data/*.db
data/*.db-*
data/evaluation_results.json
evaluation/reports/

# The canonical read-ready corpus is intentionally deployed with the app.
!data/corpus.db

# Deployment secrets must only be configured in the hosting dashboard.
.streamlit/secrets.toml

# Runtime logs
*.log

# Source documents are downloaded locally
pdfs/

# Request traces contain full prompts and retrieved source text
traces/

# Editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
# Public-repository exclusions for research benchmark artifacts
benchmark/corpus_pages.jsonl
benchmark/**/.checkpoints/
benchmark/llm_traces*/
benchmark/haiku_*/
