# Local API credentials. Copy this file to .env.local and replace placeholders.
# Never commit .env.local.
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Optional provider/model overrides for scripts/run_llm_retrievers.py.
LLM_A_MODEL=openai/gpt-5.6-sol
LLM_B_MODEL=anthropic/claude-sonnet-5
LLM_C_MODEL=gemini/gemini-3.1-pro-preview
GPT_6_LUNA_MODEL=openai/gpt-6-luna
GPT_6_LUNA_MIN_INTERVAL=7.5
CLAUDE_HAIKU_MODEL=anthropic/claude-haiku-4-5-20251001
CLAUDE_HAIKU_MIN_INTERVAL=1.0
GEMINI_FLASH_MODEL=gemini/gemini-3.7-flash
GEMINI_FLASH_MIN_INTERVAL=2.5
